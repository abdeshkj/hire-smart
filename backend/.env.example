# Backend Service Environment Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database Connections
DATABASE_URL=postgresql://postgres:password@localhost:5432/hiresmart_dev
MONGODB_URI=mongodb://localhost:27017/hiresmart_dev

# Authentication & Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Microservices
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your_ml_service_api_key_here

LOG_LEVEL=info
