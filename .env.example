# ==============================================================================
# HireSmart — Master Environment Configuration Template (.env.example)
# Single Source of Truth for all services (Backend, ML-Service, Database, Frontend)
# ==============================================================================

# ---- General Application ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL & pgvector) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/hiresmart_dev

# ---- MongoDB (Optional / Hybrid) ----
MONGODB_URI=mongodb://localhost:27017/hiresmart_dev

# ---- Authentication & Security ----
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ---- Cloud Storage / AWS S3 ----
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name_here
STORAGE_BUCKET_NAME=your_storage_bucket_name_here

# ---- ML Microservice (FastAPI & AI) ----
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000
ML_SERVICE_API_KEY=your_ml_service_api_key_here
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000

# ---- AI Models & Vector Configuration ----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/embedding-001
VECTOR_DB_URL=your_vector_db_url_here
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ---- Logging & Diagnostics ----
LOG_LEVEL=info

# ---- Frontend Client (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
