# ==============================================
# General Application Environment Configuration
# ==============================================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:3000

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hiresmart_db
# Or for MongoDB:
# MONGODB_URI=mongodb://localhost:27017/hiresmart_db

# ==============================================
# Authentication & Security
# ==============================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here

# ==============================================
# ML / AI Service Configuration
# ==============================================
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=your_ml_service_internal_secret_key
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ==============================================
# Storage / Cloud Services (Optional / S3)
# ==============================================
STORAGE_BUCKET_NAME=hiresmart-resumes
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# ==============================================
# Logging & Debugging
# ==============================================
LOG_LEVEL=info
